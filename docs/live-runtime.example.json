{
  "mode": "live",
  "checkpoint_database_path": ".recoverit/checkpoints.sqlite",
  "llm_provider": "openai",
  "llm_model": "gpt-4o-mini",
  "llm_timeout_seconds": 180.0,
  "llm_max_output_tokens": 4096,
  "max_concurrency": 4,
  "query_timeout_seconds": 10.0,
  "source_configs": [
    {
      "source_type": "changes",
      "implementation": "local_git",
      "enabled": true,
      "options": {
        "repo_path": "."
      }
    }
  ]
}
